# Copy to backend/.env — never commit .env
# Generate a local key:  openssl rand -base64 48

DJANGO_ENV=local
DEBUG=True
SECRET_KEY=
PLATFORM_NAME=Polyspace

USE_LOCMEM_CACHE=True
CELERY_TASK_ALWAYS_EAGER=True

# OTP rate limits (password-reset)
# OTP_REQUEST_PER_EMAIL_PER_HOUR=5
# OTP_REQUEST_PER_IP_PER_HOUR=20
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_VERIFY_PER_IP_PER_HOUR=40
# PASSWORD_RESET_REQUEST_THROTTLE_RATE=100/hour
# PASSWORD_RESET_VERIFY_THROTTLE_RATE=60/hour

# Phase 17 — DB connection reuse (VPS direct Postgres: 600; PgBouncer later: 0)
CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=5
# DB_STATEMENT_TIMEOUT_MS=30000

# Phase 18 — Redis cache TTLs (seconds)
CACHE_KEY_PREFIX=polyspace
CACHE_DEFAULT_TTL=60
DASHBOARD_CACHE_TTL=30
ELEVE_HOT_LIST_TTL=20
# REDIS_URL=redis://127.0.0.1:6379/1

# Phase 19 — Gunicorn / Celery (VPS 4 vCPU: workers=9 threads=2 celery=4)
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=1000
CELERY_CONCURRENCY=2

# Phase 23–24 — durable media (MinIO / R2 / S3) + delivery
# Local runserver: leave USE_S3_MEDIA=False (FileSystemStorage under MEDIA_ROOT)
USE_S3_MEDIA=False
# MEDIA_DELIVERY=stream   # stream | xaccel (xaccel only with local disk + Compose nginx)
# HEALTHZ_REQUIRE_STORAGE=False
# Phase 25 — readiness: require Redis unless USE_LOCMEM_CACHE (auto). Override:
# HEALTHZ_REQUIRE_REDIS=True
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_STORAGE_BUCKET_NAME=polyspace-media
# AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ADDRESSING_STYLE=path

# Cookie JWT (Lax + insecure OK for local HTTP; use None+True on Render split hosts)
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_SECURE=False
# JWT_COOKIE_DOMAIN=

# Login lockout
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_IP_MAX_FAILURES=30
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_THROTTLE_RATE=10/min

# Security headers (Phase 5) — leave off for local HTTP
SECURITY_HEADERS_ENABLED=False
SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000
# CSP_REPORT_ONLY=True
# API_CSP=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

# Mail — OTP password reset
# Interim (no DNS): Gmail SMTP + App Password (Google Account → Security → App passwords).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=   # 16-char app password, no spaces
# DEFAULT_FROM_EMAIL=Polyspace <you@gmail.com>
#
# Later (prod with DNS): Resend — verify domain polyspace.mr (SPF/DKIM)
# EMAIL_HOST=smtp.resend.com
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=   # Resend API key
# DEFAULT_FROM_EMAIL=Polyspace <noreply@polyspace.mr>
#
# Keep USE_LOCMEM_CACHE=True + CELERY_TASK_ALWAYS_EAGER=True (OTP in-process).
# Empty PASSWORD + DEBUG=True → console backend (OTP only in runserver logs).
# Leave EMAIL_BACKEND unset so DEBUG+empty PASSWORD → console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Polyspace <you@gmail.com>

# Phase 32 — observability (leave blank locally)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# METRICS_TOKEN=  # optional; Prometheus may scrape Docker network without token
