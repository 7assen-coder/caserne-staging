# Root env for docker-compose.prod.yml (never commit real secrets)
# cp .env.prod.example .env.prod

DB_NAME=esp
DB_USER=esp
DB_PASSWORD=change-me-strong-db-password

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
AWS_STORAGE_BUCKET_NAME=polyspace-media

GUNICORN_WORKERS=4
GUNICORN_THREADS=2
CELERY_CONCURRENCY=2

# Sentry (https://sentry.io free) — same org, environment=production via DJANGO_ENV
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Optional Prometheus scrape token
METRICS_TOKEN=

CADDY_ACME_EMAIL=ops@polyspace.mr
